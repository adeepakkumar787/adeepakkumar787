if __name__ == '__main__':
    students = []
    for _ in range(int(input())):
        name = input()
        score = float(input())
        students.append([name,score])
    score = sorted({student[1] for student in students})
    second = score[1]
    second_students = sorted([student[0] for student in students if student[1] == second])
    for name in second_students:
        print(name)
